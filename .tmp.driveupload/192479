                <main id="main-content" class="view-content-container">
                    <section class="plan-page attention-page" x-data="auditPlans" :aria-busy="loading">
    <p x-page-notice role="alert" x-show="error" x-text="error"></p><p x-page-notice x-show="notice" x-text="notice"></p>
    <div class="attention-stats" aria-label="Audit plan summary" :class="{'is-loading': loading}">
                    <article class="metric-stat-card"><div class="metric-info"><span class="metric-label">Total Plans</span><strong class="metric-number color-dark" x-text="loading ? '—' : countStatus('')"></strong></div><div class="metric-icon-box blue"><i data-lucide="clipboard-list" aria-hidden="true"></i></div></article>
                    <article class="metric-stat-card"><div class="metric-info"><span class="metric-label">Pending Approval</span><strong class="metric-number color-dark" x-text="loading ? '—' : countStatus('submitted')"></strong></div><div class="metric-icon-box purple"><i data-lucide="clock" aria-hidden="true"></i></div></article>
                    <article class="metric-stat-card"><div class="metric-info"><span class="metric-label">Approved</span><strong class="metric-number color-dark" x-text="loading ? '—' : countStatus('accepted')"></strong></div><div class="metric-icon-box blue"><i data-lucide="clipboard-check" aria-hidden="true"></i></div></article>
                    <article class="metric-stat-card"><div class="metric-info"><span class="metric-label">Returned</span><strong class="metric-number color-dark" x-text="loading ? '—' : countStatus('returned')"></strong></div><div class="metric-icon-box danger"><i data-lucide="undo-2" aria-hidden="true"></i></div></article>
            </div>
    <div class="plan-register">
    <div class="attention-tabs" role="group" aria-label="Plan status">
                    <button type="button" @click="statusFilter = ''; page = 1" :aria-pressed="statusFilter === ''" :class="{'is-active': statusFilter === ''}">All Plans</button>
                    <button type="button" @click="statusFilter = 'draft'; page = 1" :aria-pressed="statusFilter === 'draft'" :class="{'is-active': statusFilter === 'draft'}">Draft</button>
                    <button type="button" @click="statusFilter = 'submitted'; page = 1" :aria-pressed="statusFilter === 'submitted'" :class="{'is-active': statusFilter === 'submitted'}">Pending Approval</button>
                    <button type="button" @click="statusFilter = 'accepted'; page = 1" :aria-pressed="statusFilter === 'accepted'" :class="{'is-active': statusFilter === 'accepted'}">Approved</button>
                    <button type="button" @click="statusFilter = 'returned'; page = 1" :aria-pressed="statusFilter === 'returned'" :class="{'is-active': statusFilter === 'returned'}">Returned</button>
            </div>
    <div class="plan-filter-toolbar">
        <div class="attention-log-filters plan-filter-group">
            <label>Search audit plans<input type="search" placeholder="Search title or reference…" x-model="search" @input="page = 1"></label>
            <label>Filter by unit<select x-model="unitFilter" @change="page = 1"><option value="">All units</option><template x-for="unit in data.units" :key="unit.id"><option :value="unit.id" x-text="unit.name"></option></template></select></label>
            <label>Sort by<select x-model="sortBy" @change="page = 1"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="title">Title A–Z</option></select></label>
        </div>
        <button type="button" class="plan-primary plan-prepare-button" x-cloak x-show="data.canPrepare" :disabled="loading || saving" @click="edit()"><i data-lucide="plus" aria-hidden="true"></i> Prepare Audit Plan</button>
    </div>
    <div class="plan-results">
    <p class="plan-loading-status" role="status" x-show="loading">Loading audit plans…</p>
    <div class="attention-empty" x-cloak x-show="!loading && !error && !filteredPlans.length"><h3>No matching audit plans</h3><p>Try another filter.</p></div>
    <div class="attention-table-wrap" x-show="loading || filteredPlans.length">
        <table class="attention-log-table audit-plans-table"><thead><tr><th>Audit Plan</th><th>Covered Units</th><th>Schedule</th><th>Status</th><th>Action</th></tr></thead><tbody>
                            <tr class="plan-skeleton-row" x-show="loading" aria-hidden="true">
                    <td><span class="plan-skeleton"></span><span class="plan-skeleton plan-skeleton-short"></span></td>
                    <td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td>
                </tr>
                            <tr class="plan-skeleton-row" x-show="loading" aria-hidden="true">
                    <td><span class="plan-skeleton"></span><span class="plan-skeleton plan-skeleton-short"></span></td>
                    <td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td>
                </tr>
                            <tr class="plan-skeleton-row" x-show="loading" aria-hidden="true">
                    <td><span class="plan-skeleton"></span><span class="plan-skeleton plan-skeleton-short"></span></td>
                    <td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td>
                </tr>
                            <tr class="plan-skeleton-row" x-show="loading" aria-hidden="true">
                    <td><span class="plan-skeleton"></span><span class="plan-skeleton plan-skeleton-short"></span></td>
                    <td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td>
                </tr>
                            <tr class="plan-skeleton-row" x-show="loading" aria-hidden="true">
                    <td><span class="plan-skeleton"></span><span class="plan-skeleton plan-skeleton-short"></span></td>
                    <td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td><td><span class="plan-skeleton"></span></td>
                </tr>
                        <template x-for="row in visiblePlans" :key="row.id"><tr x-show="!loading">
                <td data-label="Audit Plan"><strong x-text="row.title"></strong><small x-text="row.reference"></small></td>
                <td data-label="Covered Units" x-text="unitNames(row)"></td>
                <td data-label="Schedule" x-text="schedule(row)"></td>
                <td data-label="Status"><span class="plan-state" :class="'plan-state-' + row.plan.status" x-text="row.stateLabel"></span></td>
                <td data-label="Action"><button type="button" class="attention-button" @click="openDetails(row)">View details</button></td>
            </tr></template>
        </tbody></table>
    </div>
    </div>
    <nav class="attention-pagination" aria-label="Audit plan pages" x-cloak x-show="loading || (!error && filteredPlans.length)" :style="loading ? 'visibility:hidden' : ''">
        <span x-text="`${filteredPlans.length} record${filteredPlans.length === 1 ? '' : 's'} · Page ${page} of ${lastPage}`"></span>
        <div><label class="app-page-size">Rows
    <select x-model.number="perPage" @change="page = 1" :disabled="loading" aria-label="Rows per page">
        <option value="5">5</option><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option>    </select>
</label>
<button type="button" class="attention-button" @click="page--" :disabled="page <= 1">Previous</button><button type="button" class="attention-button" @click="page++" :disabled="page >= lastPage">Next</button></div>
    </nav>
    <p class="plan-note">Only explicitly approved plans are available for new auditor assignments. Approval requires explicit permission.</p>
    </div>
    <dialog class="plan-editor plan-details" x-ref="details" aria-labelledby="plan-details-heading" @cancel="if (saving) $event.preventDefault()">
        <template x-if="detailRow"><article x-data="{ get row() { return detailRow } }">
            <header class="plan-toolbar"><div><h2 id="plan-details-heading" x-text="row.title"></h2><small x-text="row.reference"></small></div><button type="button" class="plan-secondary" :disabled="saving" @click="$refs.details.close()">Close</button></header>
            <p class="plan-state" x-text="row.stateLabel"></p>
            <p x-page-notice role="alert" x-show="error" x-text="error"></p>
            <p x-page-notice x-show="notice" x-text="notice"></p>
            <dl class="plan-summary"><dt>Scope</dt><dd x-text="row.plan.header.scope"></dd><dt>Criteria</dt><dd x-text="row.plan.header.criteria"></dd><dt>Schedule</dt><dd x-text="row.plan.header.scheduleStart + ' to ' + row.plan.header.scheduleEnd"></dd><dt>Covered units</dt><dd x-text="row.plan.header.unitIds.map(id => data.units.find(unit => unit.id === id)?.name || id).join(', ')"></dd><dt>Authorized Audit Team Leaders</dt><dd x-text="row.plan.header.reviewerIds.map(id => data.reviewers.find(person => person.id === id)?.name || id).join(', ')"></dd><dt>Independence procedure</dt><dd x-text="row.plan.header.procedureReference"></dd></dl>
            <p role="note" x-show="row.legacyWarning" x-text="row.legacyWarning"></p><details class="plan-history"><summary>Decision and revision history</summary><template x-for="(entry, index) in row.plan.history" :key="index"><p><strong x-text="entry.decision"></strong> · <span x-text="entry.actorName"></span> · <time  :datetime="entry.at" :title="entry.at" x-text="date(entry.at, {precise:true})"></time><br><span x-text="entry.remarks"></span></p></template></details>
            <div class="plan-actions"><button type="button" class="plan-secondary" x-show="row.canEdit" :disabled="saving" @click="$refs.details.close(); edit(row)">Edit Draft</button></div>
            <form class="plan-action-form" x-show="row.canEdit || row.canRevise || row.canDecide" @submit.prevent>
                <label>Remarks<textarea x-model="remarks[row.id]" required maxlength="3000" rows="2"></textarea></label>
                <div class="plan-actions">
                    <button type="submit" class="plan-primary" x-show="row.canEdit" :disabled="saving" @click="if ($el.form.reportValidity()) act(row, 'submit')">Submit for Approval</button>
                    <button type="submit" class="plan-secondary" x-show="row.canRevise" :disabled="saving" @click="if ($el.form.reportValidity()) act(row, 'revise')">Revise Plan</button>
                    <button type="submit" class="plan-secondary" x-show="row.canDecide" :disabled="saving" @click="if ($el.form.reportValidity()) act(row, 'return')">Return for Revision</button>
                    <button type="submit" class="plan-primary" x-show="row.canDecide" :disabled="saving" @click="if ($el.form.reportValidity()) act(row, 'approve')">Approve Plan</button>
                </div>
                <p class="plan-note" x-show="row.canRevise">Revising removes this plan from new assignment choices until it is approved again. Existing assignments retain their approved snapshot.</p>
            </form>
        </article></template>
    </dialog>
    <dialog class="plan-editor" x-ref="editor" aria-labelledby="plan-editor-title" @cancel="if (saving) $event.preventDefault()">
        <form @submit.prevent="save()"><header class="plan-toolbar"><h2 id="plan-editor-title">Prepare Audit Plan</h2><button type="button" class="plan-secondary" :disabled="saving" @click="$refs.editor.close()">Close</button></header>
            <p x-page-notice role="alert" x-show="error" x-text="error"></p>
            <label x-show="!editing">Controlled audit-plan document<select x-model="selected" required :disabled="!!editing"><option value="">Select the controlled audit plan document</option><template x-for="archive in documentChoices" :key="archive.id"><option :value="archive.id" x-text="`${archive.code} · ${archive.title} · ${archive.type || 'Legacy method'} · v${archive.version}${archive.eligible ? '' : ' · Classification required'}`"></option></template></select></label>
            <label x-show="!editing" class="plan-check"><input type="checkbox" x-model="showLegacy"><span>Show legacy documents needing explicit classification</span></label><div x-show="needsClassification"><p>Select only the actual controlled audit-plan document. Attendance, reports, syllabi and corrective evidence are not audit plans. Classification is recorded with your identity and reason.</p><label class="plan-check"><input type="checkbox" x-model="draft.confirmPlanDocument" :required="needsClassification">I confirm this controlled document is an audit plan.</label><label>Classification reason<textarea x-model="draft.classificationReason" :required="needsClassification" minlength="10" maxlength="1000"></textarea></label></div><fieldset><legend>Departments / offices covered</legend><template x-for="unit in data.units" :key="unit.id"><label class="plan-check"><input type="checkbox" :value="unit.id" x-model="draft.unitIds"><span x-text="unit.name"></span></label></template></fieldset>
            <fieldset><legend>Authorized Audit Team Leaders for assignments</legend><template x-for="person in data.reviewers" :key="person.id"><label class="plan-check"><input type="checkbox" :value="person.id" x-model="draft.reviewerIds"><span x-text="person.name"></span></label></template></fieldset>
            <div class="plan-dates"><label>Start date<input type="date" x-model="draft.scheduleStart" required></label><label>End date<input type="date" x-model="draft.scheduleEnd" :min="draft.scheduleStart" required></label></div>
            <label>Scope<textarea x-model="draft.scope" required maxlength="3000" rows="3"></textarea></label><label>Criteria<textarea x-model="draft.criteria" required maxlength="3000" rows="3"></textarea></label>
            <label>Applicable independence / conflict procedure<input type="text" x-model="draft.procedureReference" required minlength="5" maxlength="1000" placeholder="Procedure code, title and revision"></label>
            <label>Revision remarks<textarea x-model="draft.remarks" required maxlength="3000" rows="2"></textarea></label>
            <button type="submit" class="plan-primary" :disabled="saving || !selected">Save Draft</button>
        </form>
    </dialog>
</section>
                </main>
            </div>
        </div>
