            <label>Assigned Auditor<select name="auditorId" required aria-describedby="assignment-auditor-help"><option value="">Select an eligible auditor</option><option value="6b054a2dca7f87acb30b9865" data-units="[&quot;6b054a2dca7f87acb30b9863&quot;]">Auditor</option></select></label>
            <p id="assignment-auditor-help" class="assignment-info-note" data-assignment-auditor-help role="status" aria-live="polite">Select an authorized plan and a department or office to see eligible auditors.</p>
            <label class="assignment-schedule">Scheduled Audit Date<input type="date" name="schedule" required></label>
            <label>Audit Scope<textarea data-plan-scope readonly rows="3"></textarea></label>
            <label>Audit Criteria<textarea data-plan-criteria readonly rows="3"></textarea></label>
            <p data-plan-procedure class="assignment-info-note"></p>
            <label>Independence / conflict check notes<textarea name="independenceNotes" maxlength="2000" required rows="3"></textarea></label>
            <label class="assignment-confirm"><input type="checkbox" name="independenceConfirmed" value="1" required><span>I verified independence and conflicts under the referenced procedure, including responsibility for the work being audited.</span></label>
            <label data-change-reason hidden>Reason for assignment change<textarea name="changeReason" maxlength="2000" rows="3"></textarea></label>
            </div>
            <footer class="atl-actions"><button type="button" class="atl-secondary" data-close-assignment>Cancel</button><button type="submit" class="atl-primary" data-save-assignment>Assign Auditor</button></footer>
        </form>
    </dialog>
</div>
<dialog id="audit-scope-dialog" class="assignment-scope-dialog" aria-labelledby="audit-scope-title">
    <header class="assignment-modal-header"><div><span class="assignment-eyebrow">AUDIT DETAILS</span><h2 id="audit-scope-title">Audit Scope and Criteria</h2></div><button type="button" class="assignment-modal-close" data-close-audit-scope aria-label="Close scope and criteria"><i data-lucide="x" aria-hidden="true"></i></button></header>
    <div class="assignment-modal-body">
        <p class="assignment-info-note" data-scope-audit></p>
        <section><h3>Scope</h3><p class="assignment-scope-text" data-scope-content></p></section>
        <section><h3>Criteria</h3><p class="assignment-scope-text" data-criteria-content></p></section>
    </div>
</dialog>
                </main>
            </div>
        </div>
             <dialog id="atl-review-dialog" class="atl-review-dialog" aria-labelledby="atl-review-title">
    <header class="atl-modal-header">
        <div class="atl-modal-heading"><p class="atl-modal-kicker">COMPLITRACK / INTERNAL QUALITY AUDIT</p><h2 id="atl-review-title">Audit Results Review</h2><p data-atl-review-header-meta></p></div>
        <button type="button" data-atl-review-close aria-label="Close audit review">&times;</button>
    </header>
    <p x-page-notice class="atl-review-feedback" data-atl-review-feedback role="status" aria-live="polite" hidden></p>
    <div class="atl-review-body" data-atl-review-body aria-busy="false"></div>
</dialog>
<dialog id="atl-review-confirm" class="review-confirm" aria-labelledby="review-confirm-title">
    <h2 id="review-confirm-title">Confirm review decision</h2><p></p>
    <form method="dialog" class="atl-actions"><button value="cancel" class="atl-secondary" autofocus>Keep reviewing</button><button value="confirm" class="atl-primary">Confirm decision</button></form>
</dialog>
 </body>
