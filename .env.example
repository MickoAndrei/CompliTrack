APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=mongodb
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=mongodb

CACHE_STORE=mongodb
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=phpmailer
MAIL_SCHEME=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_AUTH_TYPE=XOAUTH2
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_OAUTH_TENANT_ID=
MAIL_OAUTH_CLIENT_ID=
MAIL_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REFRESH_TOKEN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=complitrack
JWT_SECRET=replace-with-at-least-32-random-characters

SUPER_ADMIN_EMAIL=admin@complitrack.local
SUPER_ADMIN_PASSWORD=Password123!
ENCRYPTION_KEY=base64:T0foHQkYp1tt1b7IFdqaX0LJ/0m9kt4NEHJVyMuymtE=

# Generated by start-complitrack-documents.ps1 after the local server is healthy.
ONLYOFFICE_URL=
ONLYOFFICE_INTERNAL_URL=http://127.0.0.1:8082
ONLYOFFICE_APP_URL=http://host.docker.internal:8000
ONLYOFFICE_JWT_SECRET=
